{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "lib": ["es2019", "dom"],
    "jsx": "react-native",
    "strict": false,
    "noImplicitAny": false,
    "checkJs": false,
    "skipLibCheck": true,
    "allowJs": true,
    "isolatedModules": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "index.web.tsx"],
  "exclude": ["node_modules"]
}
